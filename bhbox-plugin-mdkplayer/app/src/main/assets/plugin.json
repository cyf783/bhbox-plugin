{
  "id": "bh.box.plugin.mdk",
  "name": "MDK Player",
  "description": "MDK 视频播放引擎插件（MediaCodec 硬解/HDR/DV）",
  "type": "player",
  "mainClass": "bh.box.plugin.mdk.MdkPlugin",
  "downloadUrl": "https://h-box-release.netlify.app/release/plugins/mdkplayer.apk",
  "version": 100,
  "versionName": "1.0.0",
  "minSdk": 23,
  "minAppVersion": 385,
  "autoRun": true,
  "params": [
    {
      "id": "decoder",
      "name": "解码配置",
      "type": "radio",
      "value": "硬解码",
      "options": [
        {"name": "硬解码", "value": "硬解码"},
        {"name": "软解码", "value": "软解码"}
      ]
    },
    {
      "id": "logLevel",
      "name": "日志级别",
      "type": "radio",
      "value": "静音",
      "options": [
        {"name": "静音", "value": "静音"},
        {"name": "错误", "value": "错误"},
        {"name": "警告", "value": "警告"},
        {"name": "信息", "value": "信息"},
        {"name": "调试", "value": "调试"}
      ]
    }
  ]
}
