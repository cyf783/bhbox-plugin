      "options": [
        {"name": "硬解码", "value": "硬解码"},
        {"name": "软解码", "value": "软解码"}
      ]
    },
    {
      "id": "cache",
      "name": "磁盘缓存",
      "type": "radio",
      "value": "关闭",
      "options": [
        {"name": "关闭", "value": "关闭"},
        {"name": "开启", "value": "开启"}
      ]
    }
  ]
}
