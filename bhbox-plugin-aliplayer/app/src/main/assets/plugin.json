  "type": "player",
  "mainClass": "bh.box.plugin.ali.AliPlugin",
  "downloadUrl": "https://h-box-release.netlify.app/release/plugins/aliplayer.apk",
  "version": 120,
  "versionName": "1.2.0",
  "minSdk": 23,
  "minAppVersion": 385,
  "autoRun": true,
  "params": [
    {
      "id": "decoder",
      "name": "解码配置",
